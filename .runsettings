<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configurations for data collectors -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Determine the order in which code is analyzed -->
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*DsAlgo\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <!-- We recommend you do not change the following values: -->
            <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
            <AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>
            <CollectAnySource>False</CollectAnySource>
            <CollectPublicOnly>False</CollectPublicOnly>
            <IncludeDirectory>..\*</IncludeDirectory>
            <SingleThreadedStaticAnalysis>False</SingleThreadedStaticAnalysis>

            <!-- Output format: opencover (default) or cobertura -->
            <Format>cobertura</Format>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- Adapter Specific sections -->
  <RunConfiguration>
    <MaxCpuCount>4</MaxCpuCount>
  </RunConfiguration>
</RunSettings>
